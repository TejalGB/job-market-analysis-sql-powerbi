# Git Ignore for Data Analytics Project

# Large raw datasets (download separately via Kaggle)
*.csv
*.tsv
*.xlsx
!data/sample_naukri_1000.csv

# Power BI auto-recovery and temporary files
*.tmp
~$*
*.pbix.cache

# Python environment & cache
__pycache__/
*.py[cod]
*.class
.ipynb_checkpoints/
.venv/
env/
